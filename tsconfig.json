{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": [
    "worker/**/*.ts",
    "tests/**/*.ts",
    "cloudflare.config.ts",
    "vite.config.ts",
    "worker-configuration.d.ts"
  ]
}
